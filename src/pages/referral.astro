---
import Layout from '../layouts/Layout.astro';
import StickyHeader from '../components/StickyHeader.astro';
import Footer from '../components/Footer.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import { Users, Gift, Share2, Sparkles, CheckCircle2, MessageCircle } from 'lucide-astro';

const referralSteps = [
  {
    step: "01",
    icon: Share2,
    title: "Vraag Jouw Unieke Code Aan",
    description: "Stuur ons een kort berichtje via WhatsApp om jouw persoonlijke referral-link of code te ontvangen gekoppeld aan jouw account."
  },
  {
    step: "02",
    icon: Users,
    title: "Deel met Vrienden & Familie",
    description: "Stuur jouw code door naar vrienden, familie of collega's die op zoek zijn naar een betrouwbaar IPTV abonnement in Nederland."
  },
  {
    step: "03",
    icon: Gift,
    title: "Ontvang 1 Maand Gratis",
    description: "Zodra jouw doorverwezen vriend een abonnement afsluit, voegen wij automatisch 1 volle maand gratis streamingtijd toe aan jouw account!"
  }
];
---

<Layout 
  title="Referral Programma — Verdien Gratis Maanden IPTV"
  description="Deel IPTV Nederlandse met vrienden en familie en verdien voor iedere aanmelding 1 maand gratis streamingtijd op jouw abonnement."
>
  <StickyHeader />

  <main class="pt-32 pb-24 relative overflow-hidden bg-[#0a0a0f] min-h-screen">
    <!-- Ambient background -->
    <div class="absolute top-20 left-1/2 -translate-x-1/2 w-[700px] h-[350px] bg-gradient-to-r from-[#7c4ec2]/20 via-[#38bdf8]/15 to-[#e94560]/20 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      
      <!-- Hero Header -->
      <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[#38bdf8]/15 border border-[#38bdf8]/30 text-[#38bdf8] text-xs font-bold uppercase tracking-wider">
          <Sparkles class="w-3.5 h-3.5" />
          Exclusief Viraal Beloningsprogramma
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight">
          Nodig Vrienden Uit & Kijk <br />
          <span class="text-gradient">Volledig Gratis TV</span>
        </h1>
        <p class="text-base sm:text-lg text-gray-300">
          Waarom betalen voor televisie als je vrienden kunt laten meegenieten? Voor elke vriend die zich aanmeldt via jouw referral code, ontvang jij <strong>1 maand gratis verlenging</strong>.
        </p>
      </div>

      <!-- 3 Steps Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-16">
        {referralSteps.map((item) => {
          const IconComponent = item.icon;
          return (
            <div class="glass-card rounded-3xl p-7 flex flex-col justify-between hover:border-[#38bdf8]/40 transition-all duration-300 group">
              <div>
                <div class="flex items-center justify-between mb-6">
                  <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-[#7c4ec2]/20 to-[#38bdf8]/20 border border-white/10 flex items-center justify-center group-hover:scale-110 transition-transform">
                    <IconComponent class="w-6 h-6 text-[#38bdf8]" />
                  </div>
                  <span class="text-2xl font-black font-mono text-white/15 group-hover:text-[#38bdf8]/40 transition-colors">
                    {item.step}
                  </span>
                </div>
                <h3 class="text-lg font-bold text-white mb-2.5">{item.title}</h3>
                <p class="text-xs sm:text-sm text-gray-400 leading-relaxed">{item.description}</p>
              </div>

              <div class="mt-6 pt-4 border-t border-white/5 flex items-center gap-2 text-xs text-emerald-400 font-semibold">
                <CheckCircle2 class="w-4 h-4" />
                <span>Geen limiet op aantal vrienden</span>
              </div>
            </div>
          );
        })}
      </div>

      <!-- Interactive Claim Callout Box -->
      <div class="glass-card-glow rounded-3xl p-8 sm:p-12 border border-[#7c4ec2]/40 text-center space-y-6 shadow-2xl">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-white">
          Klaar om Jouw Gratis Maanden te Claimen?
        </h2>
        <p class="text-sm text-gray-300 max-w-xl mx-auto leading-relaxed">
          Neem direct contact op met onze WhatsApp helpdesk. We genereren jouw persoonlijke link binnen 2 minuten zodat je meteen kunt beginnen met delen!
        </p>

        <div class="pt-2 flex flex-col sm:flex-row items-center justify-center gap-4 max-w-md mx-auto">
          <a 
            href="https://wa.me/18036582620?text=Hallo%20IPTV%20Nederlandse,%20ik%20wil%20graag%20mijn%20persoonlijke%20referral%20code%20aanvragen."
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto px-8 py-4 rounded-xl bg-gradient-to-r from-[#7c4ec2] to-[#e94560] text-white font-extrabold text-sm shadow-xl shadow-[#7c4ec2]/30 hover:scale-105 transition-all flex items-center justify-center gap-2"
          >
            <MessageCircle class="w-5 h-5" />
            <span>Vraag Referral Code via WhatsApp</span>
          </a>
        </div>
      </div>

    </div>
  </main>

  <FloatingWhatsApp />
  <Footer />
</Layout>
