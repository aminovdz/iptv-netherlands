---
import Layout from '../layouts/Layout.astro';
import StickyHeader from '../components/StickyHeader.astro';
import Hero from '../components/Hero.astro';
import LiveScores from '../components/LiveScores.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import PricingCard from '../components/PricingCard.astro';
import ReferralBanner from '../components/ReferralBanner.astro';
import UserReviewsSection from '../components/UserReviewsSection.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import SupportedDevices from '../components/SupportedDevices.astro';
import CitiesList from '../components/CitiesList.astro';
import ContactForm from '../components/ContactForm.astro';
import FAQSection from '../components/FAQSection.astro';
import CTASection from '../components/CTASection.astro';
import Footer from '../components/Footer.astro';

import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import GroupsPopup from '../components/GroupsPopup.astro';
import ExitPopup from '../components/ExitPopup.astro';
import SocialPopup from '../components/SocialPopup.astro';

const v2Schema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "IPTV met Abonnement - Sport & Eredivisie Editie",
  "image": "https://iptvnederlandse.store/favicon.svg",
  "description": "Beste IPTV met abonnement voor live sport, Eredivisie en Europese topcompetities in 4K 60FPS zonder haperingen.",
  "brand": {
    "@type": "Brand",
    "name": "IPTV Nederlandse"
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "reviewCount": "9850"
  },
  "offers": {
    "@type": "AggregateOffer",
    "lowPrice": "5.00",
    "highPrice": "35.00",
    "priceCurrency": "EUR",
    "offerCount": "4"
  }
};
---

<Layout 
  title="IPTV Abonnement Kopen — Live Sport & Eredivisie in 4K 60FPS"
  description="Kies voor het beste IPTV met abonnement in Nederland. Volg alle Eredivisie en Europese live sportwedstrijden in 4K UHD zonder buffering. Direct binnen 5 min live!"
  schema={v2Schema}
>
  <StickyHeader />

  <main>
    <!-- 1. Hero Section -->
    <Hero />

    <!-- Live Sports Scores Widget -->
    <LiveScores />

    <!-- 2. Features Grid -->
    <FeatureGrid />

    <!-- Deep SEO Sports & Anti-Freeze Content Block (~1,200 words total page density) -->
    <section class="py-16 bg-[#0d0d14] border-t border-b border-white/5">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8 text-gray-300 text-sm sm:text-base leading-relaxed">
        
        <div class="space-y-4">
          <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
            De Ultieme Sportbeleving met een <span class="text-gradient">IPTV met Abonnement</span>
          </h2>
          <p>
            Voor sportfanaten is er niets frustrerender dan een stream die blijft bufferen op het moment dat er een doelpunt valt. Wanneer je besluit een <strong>iptv abbo kopen</strong>, wil je absolute zekerheid dat jouw favoriete wedstrijden vloeiend en haarscherp worden weergegeven. <strong>IPTV Nederlandse</strong> heeft haar complete serverpark ingericht op high-throughput datacenterverbindingen met lage responstijden, waardoor je kijkt met een kristalheldere 60 frames per seconde streamkwaliteit.
          </p>
          <p>
            Of je nu de zondagmiddagwedstrijden in de Eredivisie volgt, de zinderende knock-outfases van het Europese topvoetbal, of internationale motorsport: met ons <strong>ip tv abonnement</strong> mis je geen enkele seconde actie. Dankzij de compatibiliteit met applicaties zoals <strong>TiviMate, IBO Player en IPTV Smarters Pro</strong> navigeer je bliksemsnel tussen sportkanalen zonder merkbare vertraging.
          </p>
        </div>

        <!-- Technical Performance Table -->
        <div class="space-y-4 pt-4">
          <h3 class="text-xl font-bold text-white">
            Technische Specificaties van Onze Streaming Servers
          </h3>
          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs sm:text-sm border-collapse glass-card rounded-2xl overflow-hidden">
              <thead>
                <tr class="border-b border-white/10 bg-white/5 text-white">
                  <th class="p-4 font-bold">Specificatie</th>
                  <th class="p-4 font-bold text-[#38bdf8]">Onze Servers</th>
                  <th class="p-4 font-bold text-gray-400">Standaard IPTV Aanbieders</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-white/5 text-gray-300">
                <tr>
                  <td class="p-4 font-semibold text-white">Framerate (FPS)</td>
                  <td class="p-4 text-emerald-400 font-bold">Vaste 60 FPS (Vloeiende actie)</td>
                  <td class="p-4 text-gray-400">Vaak 25 - 30 FPS (Schokkerig beeld)</td>
                </tr>
                <tr>
                  <td class="p-4 font-semibold text-white">Uptime Garantie</td>
                  <td class="p-4 text-emerald-400 font-bold">99.9% Dedicated Uptime</td>
                  <td class="p-4 text-gray-400">Onstabiele overboekte servers</td>
                </tr>
                <tr>
                  <td class="p-4 font-semibold text-white">Nederlandse ISP Optimalisatie</td>
                  <td class="p-4 text-emerald-400 font-bold">Geoptimaliseerd voor Ziggo, KPN & Odido</td>
                  <td class="p-4 text-gray-400">Geen directe routing naar Nederland</td>
                </tr>
                <tr>
                  <td class="p-4 font-semibold text-white">EPG TV-Gids Nauwkeurigheid</td>
                  <td class="p-4 text-emerald-400 font-bold">Real-time automatische synchronisatie</td>
                  <td class="p-4 text-gray-400">Ontbrekende of verouderde programmagids</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <div class="space-y-4 pt-4">
          <h3 class="text-xl font-bold text-white">
            Eenvoudige Installatie op Smart TV en Streaming Sticks
          </h3>
          <p>
            Een <strong>ip tv kopen</strong> hoeft absoluut niet ingewikkeld te zijn. Binnen 5 minuten na jouw aankoop ontvang je via WhatsApp en e-mail zowel jouw M3U-afspeellijst als Xtream Codes inloggegevens. Je hoeft deze enkel in te vullen in jouw favoriete app op je Samsung, LG of Android TV, en alle categorieën en sportuitzendingen staan direct overzichtelijk voor je klaar.
          </p>
          <p>
            Bovendien ontvang je bij ons 12-maanden pakket (€35,-) de professionele <strong>IBO Player applicatie activatie t.w.v. €15,- helemaal gratis</strong>. Hiermee ben je in één keer klaar voor een heel jaar lang zorgeloos kijkplezier.
          </p>
        </div>

      </div>
    </section>

    <!-- 3. Pricing Section (12-Month Anchored First) -->
    <PricingCard />

    <!-- 4. Referral Viral Banner -->
    <ReferralBanner />

    <!-- 5. Testimonials & Reviews -->
    <UserReviewsSection />

    <!-- 6. How to Process (3 Steps) -->
    <ProcessSteps />

    <!-- 7. Supported Devices -->
    <SupportedDevices />

    <!-- 8. Programmatic Dutch Cities -->
    <CitiesList />

    <!-- 9. Contact Section -->
    <ContactForm />

    <!-- 10. FAQ Section -->
    <FAQSection />

    <!-- 11. Final CTA Banner -->
    <CTASection />
  </main>

  <!-- Interactive Marketing Widgets -->
  <FloatingWhatsApp />
  <GroupsPopup />
  <ExitPopup />
  <SocialPopup />

  <Footer />
</Layout>
