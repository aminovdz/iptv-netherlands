---
import Layout from '../layouts/Layout.astro';
import StickyHeader from '../components/StickyHeader.astro';
import Hero from '../components/Hero.astro';
import LiveScores from '../components/LiveScores.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import PricingCard from '../components/PricingCard.astro';
import ReferralBanner from '../components/ReferralBanner.astro';
import UserReviewsSection from '../components/UserReviewsSection.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import SupportedDevices from '../components/SupportedDevices.astro';
import CitiesList from '../components/CitiesList.astro';
import ContactForm from '../components/ContactForm.astro';
import FAQSection from '../components/FAQSection.astro';
import CTASection from '../components/CTASection.astro';
import Footer from '../components/Footer.astro';

import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import GroupsPopup from '../components/GroupsPopup.astro';
import ExitPopup from '../components/ExitPopup.astro';
import SocialPopup from '../components/SocialPopup.astro';

const v3Schema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "IPTV met Abonnement - IBO Player All-In Bonus Pakket",
  "image": "https://iptvnederlandse.store/favicon.svg",
  "description": "Exclusieve IPTV aanbieding met gratis IBO Player activatie bonus. Directe levering binnen 5 minuten.",
  "brand": {
    "@type": "Brand",
    "name": "IPTV Nederlandse"
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "reviewCount": "9850"
  },
  "offers": {
    "@type": "AggregateOffer",
    "lowPrice": "5.00",
    "highPrice": "35.00",
    "priceCurrency": "EUR",
    "offerCount": "4"
  }
};
---

<Layout 
  title="IPTV Kopen — Direct Activeren & Gratis IBO Player Bonus"
  description="Koop direct een voordelig IPTV met abonnement. Inclusief gratis IBO Player activatie bonus, 4K beeldkwaliteit, veilige betaling en directe levering."
  schema={v3Schema}
>
  <StickyHeader />

  <main class="relative bg-[#0a0a0f] overflow-hidden">
    <!-- Hero Banner with Direct Anchor -->
    <section class="pt-32 pb-16 relative overflow-hidden">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6">
        <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[#e94560]/15 border border-[#e94560]/30 text-[#ff758f] text-xs font-bold uppercase tracking-wider">
          Directe Levering & Gratis App Licentie
        </span>
        
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black text-white tracking-tight max-w-4xl mx-auto leading-tight">
          IPTV Kopen met <span class="text-gradient">Gratis IBO Player</span> Activatie
        </h1>
        
        <p class="text-sm sm:text-base text-gray-300 max-w-2xl mx-auto">
          Bespaar maximaal met ons all-in 12-maanden pakket voor slechts <strong>€35,-</strong> inclusief levenslange app-vrijgave. Geen verborgen kosten, direct geactiveerd.
        </p>

        <!-- 3 Quick Pillars -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 max-w-4xl mx-auto pt-6 text-left">
          <div class="glass-card rounded-2xl p-6 border border-white/10 space-y-2">
            <span class="text-xs font-bold text-[#7c4ec2] uppercase tracking-wider block">Pijler 1</span>
            <h3 class="text-lg font-bold text-white">IBO Player Bonus</h3>
            <p class="text-xs text-gray-400 leading-relaxed">
              Geen gedoe met verlopende proefperiodes. Wij activeren de app direct op basis van jouw MAC-adres.
            </p>
          </div>

          <div class="glass-card rounded-2xl p-6 border border-white/10 space-y-2">
            <span class="text-xs font-bold text-emerald-400 uppercase tracking-wider block">Pijler 2</span>
            <h3 class="text-lg font-bold text-white">100% Veilige Betaling</h3>
            <p class="text-xs text-gray-400 leading-relaxed">
              Reken eenvoudig en beveiligd af via Bancontact, Visa/Mastercard of anoniem via Crypto met 10% extra korting.
            </p>
          </div>

          <div class="glass-card rounded-2xl p-6 border border-white/10 space-y-2">
            <span class="text-xs font-bold text-[#e94560] uppercase tracking-wider block">Pijler 3</span>
            <h3 class="text-lg font-bold text-white">24/7 WhatsApp Hulp</h3>
            <p class="text-xs text-gray-400 leading-relaxed">
              Heb je ondersteuning nodig bij de configuratie of installatie? Ons Nederlandstalige supportteam staat dag en nacht voor je klaar.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 1. Hero Section -->
    <Hero />

    <!-- Live Sports Scores Widget -->
    <LiveScores />

    <!-- 2. Features Grid -->
    <FeatureGrid />

    <!-- In-depth E-E-A-T Value & App Integration Content Block (~1,200 words total page density) -->
    <section class="py-16 bg-[#0a0a0f] border-t border-b border-white/5">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8 text-gray-300 text-sm sm:text-base leading-relaxed">
        
        <div class="space-y-4">
          <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
            Het Meest Complete <span class="text-gradient">IPTV met Abonnement</span> van Nederland
          </h2>
          <p>
            Ben je op zoek naar de beste deal om een <strong>iptv met abonnement</strong> af te sluiten? Bij <strong>IPTV Nederlandse</strong> geloven we in ongecompliceerde service met de beste prijs-kwaliteitverhouding. Geen ingewikkelde contracten, geen automatische incasso's die je vergeet op te zeggen, maar heldere eenmalige tarieven vanaf slechts €5 per maand tot ons populaire jaarabonnement van €35 inclusief gratis <strong>IBO Player</strong> app-activatie.
          </p>
          <p>
            Met duizenden tevreden Nederlandse huishoudens in steden als Amsterdam, Rotterdam, Den Haag en Utrecht hebben we onze infrastructuur geperfectioneerd. Wie een <strong>ip tv abonnement</strong> bij ons activeert, profiteert van haarscherpe 4K Ultra HD en Full HD resoluties, directe synchronisatie van de Nederlandse elektronische programmagids (EPG) en onbeperkte toegang tot live sportevenementen.
          </p>
        </div>

        <div class="space-y-4 pt-4">
          <h3 class="text-xl font-bold text-white">
            Hoe Werkt een IPTV Abbo Kopen bij IPTV Nederlandse?
          </h3>
          <p>
            Het proces is simpel: kies hieronder jouw pakket, voltooi de veilige transactie en ontvang jouw unieke inlogcodes via WhatsApp en e-mail. Of je nu streamt via een Samsung TV, LG Smart TV, Amazon Firestick, Android Box, Apple TV of tablet: met <strong>IPTV Nederlandse</strong> ben je binnen 5 minuten live.
          </p>
        </div>

      </div>
    </section>

    <!-- 3. Pricing Section (12-Month Anchored First) -->
    <PricingCard />

    <!-- 4. Referral Viral Banner -->
    <ReferralBanner />

    <!-- 5. Testimonials & Reviews -->
    <UserReviewsSection />

    <!-- 6. How to Process (3 Steps) -->
    <ProcessSteps />

    <!-- 7. Supported Devices -->
    <SupportedDevices />

    <!-- 8. Programmatic Dutch Cities -->
    <CitiesList />

    <!-- 9. Contact Section -->
    <ContactForm />

    <!-- 10. FAQ Section -->
    <FAQSection />

    <!-- 11. Final CTA Banner -->
    <CTASection />
  </main>

  <!-- Interactive Marketing Widgets -->
  <FloatingWhatsApp />
  <GroupsPopup />
  <ExitPopup />
  <SocialPopup />

  <Footer />
</Layout>
