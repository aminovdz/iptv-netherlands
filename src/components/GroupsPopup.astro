---
import { MessageCircle, Send, X, Bell } from 'lucide-astro';
---

<div 
  id="groups-popup" 
  class="fixed bottom-6 right-6 z-40 max-w-md w-full transition-all duration-500 transform translate-y-32 opacity-0 pointer-events-none"
  role="complementary"
  aria-label="Word lid van onze officiële IPTV kanalen"
>
  <div class="glass-card-glow rounded-3xl p-6 border border-[#7c4ec2]/40 shadow-2xl relative">
    
    <!-- Dismiss button -->
    <button 
      id="close-groups-popup"
      type="button"
      class="absolute top-3 right-3 w-8 h-8 rounded-full bg-white/10 hover:bg-white/20 text-gray-400 hover:text-white flex items-center justify-center transition-colors"
      aria-label="Sluit melding"
    >
      <X class="w-4 h-4" />
    </button>

    <!-- Header badge -->
    <div class="flex items-center gap-2 mb-3">
      <div class="w-8 h-8 rounded-xl bg-gradient-to-tr from-emerald-500 to-[#38bdf8] flex items-center justify-center">
        <Bell class="w-4 h-4 text-white" />
      </div>
      <div>
        <span class="text-xs font-bold text-white block">Officiële VIP Community</span>
        <span class="text-[10px] text-emerald-400 font-semibold">Ontvang directe updates & acties</span>
      </div>
    </div>

    <!-- Description -->
    <p class="text-xs text-gray-300 leading-relaxed mb-4">
      Mis geen enkele server-update, wedstrijd-aankondiging of exclusieve kortingscode. Sluit je aan bij onze officiële Nederlandse community!
    </p>

    <!-- Action Buttons Grid -->
    <div class="grid grid-cols-2 gap-2.5">
      <a 
        href="https://whatsapp.com/channel/0029VayVaLpD8SE3bf8wMY3v"
        target="_blank"
        rel="noopener noreferrer"
        class="py-2.5 px-3 rounded-xl bg-emerald-600/30 hover:bg-emerald-600/50 border border-emerald-500/40 text-emerald-300 text-xs font-bold flex items-center justify-center gap-1.5 transition-all"
      >
        <MessageCircle class="w-4 h-4 text-emerald-400" />
        <span>WhatsApp Kanaal</span>
      </a>

      <a 
        href="https://t.me/castvera_com"
        target="_blank"
        rel="noopener noreferrer"
        class="py-2.5 px-3 rounded-xl bg-sky-600/30 hover:bg-sky-600/50 border border-sky-500/40 text-sky-300 text-xs font-bold flex items-center justify-center gap-1.5 transition-all"
      >
        <Send class="w-4 h-4 text-sky-400" />
        <span>Telegram VIP</span>
      </a>
    </div>

  </div>
</div>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const popup = document.getElementById('groups-popup');
    const closeBtn = document.getElementById('close-groups-popup');

    const STORAGE_KEY = 'groups_popup_session_24h';
    const TWENTY_FOUR_HOURS = 24 * 60 * 60 * 1000; // 24 hours in ms

    function isSuppressed() {
      const lastDismissed = localStorage.getItem(STORAGE_KEY);
      if (!lastDismissed) return false;
      const elapsed = Date.now() - parseInt(lastDismissed, 10);
      return elapsed < TWENTY_FOUR_HOURS;
    }

    function recordDismissed() {
      localStorage.setItem(STORAGE_KEY, Date.now().toString());
    }

    function showGroupsPopup() {
      if (isSuppressed() || !popup) return;
      popup.classList.remove('translate-y-32', 'opacity-0', 'pointer-events-none');
      popup.classList.add('translate-y-0', 'opacity-100', 'pointer-events-auto');
    }

    // Trigger after 15 seconds on page if not suppressed in the last 24 hours
    setTimeout(() => {
      showGroupsPopup();
    }, 15000);

    closeBtn?.addEventListener('click', () => {
      recordDismissed();
      popup?.classList.remove('translate-y-0', 'opacity-100', 'pointer-events-auto');
      popup?.classList.add('translate-y-32', 'opacity-0', 'pointer-events-none');
    });
  });
</script>
