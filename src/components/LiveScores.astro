---
import { Trophy, Tv, Play, Sparkles, ShieldCheck, Flame } from 'lucide-astro';

const matches = [
  {
    league: "Eredivisie",
    home: "PSV Eindhoven",
    away: "Feyenoord",
    homeScore: "2",
    awayScore: "1",
    status: "LIVE 74'",
    isLive: true,
    quality: "4K 60FPS",
    stadium: "Philips Stadion"
  },
  {
    league: "Eredivisie",
    home: "Ajax Amsterdam",
    away: "FC Utrecht",
    homeScore: "3",
    awayScore: "0",
    status: "LIVE 58'",
    isLive: true,
    quality: "4K 60FPS",
    stadium: "Johan Cruijff ArenA"
  },
  {
    league: "Eredivisie",
    home: "AZ Alkmaar",
    away: "FC Twente",
    homeScore: "-",
    awayScore: "-",
    status: "Vandaag 20:00",
    isLive: false,
    quality: "4K UHD Ready",
    stadium: "AFAS Stadion"
  },
  {
    league: "Eredivisie",
    home: "NEC Nijmegen",
    away: "Go Ahead Eagles",
    homeScore: "-",
    awayScore: "-",
    status: "Morgen 14:30",
    isLive: false,
    quality: "4K UHD Ready",
    stadium: "Goffertstadion"
  }
];
---

<section class="py-16 relative overflow-hidden bg-[#0d0d14]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Header -->
    <div class="flex flex-col md:flex-row items-center justify-between gap-6 mb-10 text-center md:text-left">
      <div class="space-y-2">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#e94560]/15 border border-[#e94560]/30 text-[#ff758f] text-xs font-bold uppercase tracking-wider">
          <Flame class="w-3.5 h-3.5" />
          Live Eredivisie Sport Hub
        </div>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
          Volg Iedere Wedstrijd <span class="text-gradient">in Haarscherpe 4K</span>
        </h2>
      </div>

      <a 
        href="#pricing" 
        class="px-5 py-2.5 rounded-xl bg-white/5 hover:bg-white/10 text-white font-bold text-xs border border-white/10 transition-all flex items-center gap-2 shrink-0"
      >
        <span>Bekijk Sportpakketten</span>
        <Play class="w-3.5 h-3.5 text-[#e94560] fill-current" />
      </a>
    </div>

    <!-- Match Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
      {matches.map((match) => (
        <div class="glass-card rounded-2xl p-5 border border-white/10 hover:border-[#7c4ec2]/40 transition-all duration-300 flex flex-col justify-between group">
          
          <!-- Top League Bar -->
          <div class="flex items-center justify-between text-xs mb-4">
            <span class="font-bold text-gray-400 uppercase tracking-wider text-[11px]">{match.league}</span>
            {match.isLive ? (
              <span class="px-2 py-0.5 rounded-md bg-red-500/20 text-red-400 border border-red-500/30 text-[11px] font-extrabold flex items-center gap-1">
                <span class="w-1.5 h-1.5 rounded-full bg-red-500 animate-ping"></span>
                {match.status}
              </span>
            ) : (
              <span class="text-gray-500 text-[11px] font-medium">{match.status}</span>
            )}
          </div>

          <!-- Teams & Scores -->
          <div class="space-y-2.5 my-2">
            <div class="flex items-center justify-between">
              <span class="text-sm font-bold text-white group-hover:text-[#d1b3ff] transition-colors">{match.home}</span>
              <span class="text-base font-extrabold text-white font-mono">{match.homeScore}</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-sm font-bold text-white group-hover:text-[#d1b3ff] transition-colors">{match.away}</span>
              <span class="text-base font-extrabold text-white font-mono">{match.awayScore}</span>
            </div>
          </div>

          <!-- Bottom Quality & Stream Pill -->
          <div class="mt-4 pt-3 border-t border-white/5 flex items-center justify-between text-[11px] text-gray-400">
            <span class="text-emerald-400 font-semibold">{match.quality}</span>
            <span class="text-gray-500 text-[10px]">{match.stadium}</span>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>
