---
import { MapPin, ArrowRight, Signal, ShieldCheck, Zap } from 'lucide-astro';

const cities = [
  { name: 'Amsterdam', slug: 'amsterdam', province: 'Noord-Holland', speed: '< 8ms' },
  { name: 'Rotterdam', slug: 'rotterdam', province: 'Zuid-Holland', speed: '< 9ms' },
  { name: 'Den Haag', slug: 'den-haag', province: 'Zuid-Holland', speed: '< 9ms' },
  { name: 'Utrecht', slug: 'utrecht', province: 'Utrecht', speed: '< 8ms' },
  { name: 'Eindhoven', slug: 'eindhoven', province: 'Noord-Brabant', speed: '< 10ms' },
  { name: 'Groningen', slug: 'groningen', province: 'Groningen', speed: '< 12ms' },
  { name: 'Tilburg', slug: 'tilburg', province: 'Noord-Brabant', speed: '< 10ms' },
  { name: 'Almere', slug: 'almere', province: 'Flevoland', speed: '< 9ms' },
  { name: 'Breda', slug: 'breda', province: 'Noord-Brabant', speed: '< 10ms' },
  { name: 'Nijmegen', slug: 'nijmegen', province: 'Gelderland', speed: '< 11ms' }
];
---

<section id="locations" class="py-20 md:py-28 relative overflow-hidden bg-[#0d0d14]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/5 border border-white/10 text-xs font-bold text-[#38bdf8] uppercase tracking-wider">
        <MapPin class="w-3.5 h-3.5 text-[#e94560]" />
        Landelijke Nederlandse Dekking
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight">
        IPTV met Abonnement in <span class="text-gradient">Jouw Regio</span>
      </h2>
      <p class="text-base sm:text-lg text-gray-400">
        Onze servers zijn direct gekoppeld aan de belangrijkste internetknooppunten in Nederland (zoals AMS-IX). Hierdoor profiteer je in elke stad van minimale latency en maximale stabiliteit.
      </p>
    </div>

    <!-- Cities Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
      {cities.map((city) => (
        <a 
          href={`/locations/${city.slug}`}
          class="glass-card rounded-2xl p-4 sm:p-5 hover:border-[#7c4ec2]/50 hover:bg-white/[0.06] transition-all duration-300 group flex flex-col justify-between"
          aria-label={`Bekijk IPTV met abonnement in ${city.name}`}
        >
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
              <span class="text-[10px] font-mono text-[#38bdf8] bg-white/5 px-2 py-0.5 rounded">
                {city.speed}
              </span>
            </div>
            <h3 class="text-base font-bold text-white group-hover:text-[#d1b3ff] transition-colors">
              {city.name}
            </h3>
            <span class="text-xs text-gray-400 block">{city.province}</span>
          </div>

          <div class="mt-4 pt-2 border-t border-white/5 flex items-center justify-between text-xs text-gray-400 group-hover:text-white transition-colors">
            <span>Direct Live</span>
            <ArrowRight class="w-3.5 h-3.5 text-[#e94560] group-hover:translate-x-1 transition-transform" />
          </div>
        </a>
      ))}
    </div>

    <!-- Dutch ISP Optimization Trust Badge -->
    <div class="mt-12 p-6 rounded-2xl glass-card border border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-gray-300 text-center sm:text-left">
      <div class="flex items-center gap-3">
        <Signal class="w-5 h-5 text-emerald-400 shrink-0" />
        <span>Geoptimaliseerd voor alle Nederlandse glasvezel- en kabelproviders (Ziggo, KPN, Odido, Delta, Caiway).</span>
      </div>
      <a href="#pricing" class="text-[#38bdf8] font-bold hover:underline shrink-0">
        Bekijk alle abonnementen →
      </a>
    </div>

  </div>
</section>
