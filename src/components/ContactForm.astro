---
import { Mail, MessageCircle, Send, Headphones } from 'lucide-astro';
---

<section id="contact" class="py-20 md:py-28 relative overflow-hidden bg-[#0a0a0f]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/5 border border-white/10 text-xs font-bold text-[#38bdf8] uppercase tracking-wider">
        <Headphones class="w-3.5 h-3.5" />
        24/7 Bereikbaar
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight">
        Neem Contact Op Met <span class="text-gradient">Onze Klantenservice</span>
      </h2>
      <p class="text-xs sm:text-sm text-gray-400 max-w-lg mx-auto">
        Heb je hulp nodig bij de installatie, wil je een vraag stellen over je bestelling, of zoek je advies voor jouw Smart TV? We staan dag en nacht voor je klaar.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      
      <!-- Left Column: Official Contact Channels & Community Info -->
      <div class="lg:col-span-5 space-y-6">
        
        <!-- WhatsApp Direct Card -->
        <div class="glass-card-glow rounded-3xl p-6 sm:p-7 border border-emerald-500/30 relative group">
          <div class="flex items-center gap-4 mb-4">
            <div class="w-12 h-12 rounded-2xl bg-emerald-500/20 border border-emerald-500/40 flex items-center justify-center">
              <MessageCircle class="w-6 h-6 text-emerald-400" />
            </div>
            <div>
              <span class="text-xs font-bold text-emerald-400 uppercase tracking-wider block">Snelste Reactie (2 min)</span>
              <h3 class="text-lg font-bold text-white">Directe WhatsApp Support</h3>
            </div>
          </div>
          <p class="text-xs sm:text-sm text-gray-300 mb-4 leading-relaxed">
            Chat direct met een Nederlandstalige specialist voor proefperiodes, abonnementsactivaties of hulp bij app-installaties.
          </p>
          <a 
            href="https://wa.me/18036582620?text=Hallo%20IPTV%20Nederlandse,%20ik%20heb%20een%20vraag%20of%20zoek%20ondersteuning."
            target="_blank"
            rel="noopener noreferrer"
            class="w-full py-3 px-4 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs flex items-center justify-center gap-2 shadow-lg shadow-emerald-900/40 transition-all"
          >
            <MessageCircle class="w-4 h-4" />
            <span>Open WhatsApp Chat (+1 803 658 2620)</span>
          </a>
        </div>

        <!-- Official Channels & Emails Box -->
        <div class="glass-card rounded-3xl p-6 sm:p-7 space-y-5">
          <h3 class="text-base font-bold text-white border-b border-white/10 pb-3">Officiële Kanalen & E-mailadressen</h3>
          
          <div class="space-y-4 text-xs">
            <!-- Verkoop Email -->
            <div class="flex items-start gap-3">
              <Mail class="w-4 h-4 text-[#38bdf8] shrink-0 mt-0.5" />
              <div>
                <span class="text-gray-400 block">Algemene Vragen & Verkoop:</span>
                <a href="mailto:contact@iptvnederlandse.store" class="text-white font-bold hover:text-[#38bdf8] transition-colors">
                  contact@iptvnederlandse.store
                </a>
              </div>
            </div>

            <!-- Technische Support Email -->
            <div class="flex items-start gap-3">
              <Mail class="w-4 h-4 text-[#7c4ec2] shrink-0 mt-0.5" />
              <div>
                <span class="text-gray-400 block">Technische Ondersteuning:</span>
                <a href="mailto:support@castvera.com" class="text-white font-bold hover:text-[#7c4ec2] transition-colors">
                  support@castvera.com
                </a>
              </div>
            </div>

            <!-- WhatsApp Channel -->
            <div class="flex items-start gap-3">
              <MessageCircle class="w-4 h-4 text-emerald-400 shrink-0 mt-0.5" />
              <div>
                <span class="text-gray-400 block">Officieel WhatsApp Nieuwskanaal:</span>
                <a href="https://whatsapp.com/channel/0029VayVaLpD8SE3bf8wMY3v" target="_blank" rel="noopener noreferrer" class="text-emerald-400 font-bold hover:underline">
                  Volg ons WhatsApp Kanaal →
                </a>
              </div>
            </div>

            <!-- Telegram Channel -->
            <div class="flex items-start gap-3">
              <Send class="w-4 h-4 text-sky-400 shrink-0 mt-0.5" />
              <div>
                <span class="text-gray-400 block">Officieel Telegram VIP Kanaal:</span>
                <a href="https://t.me/castvera_com" target="_blank" rel="noopener noreferrer" class="text-sky-400 font-bold hover:underline">
                  @castvera_com op Telegram →
                </a>
              </div>
            </div>
          </div>
        </div>

      </div>

      <!-- Right Column: Interactive Contact Form -->
      <div class="lg:col-span-7">
        <div class="glass-card rounded-3xl p-6 sm:p-8 md:p-10 border border-white/10">
          
          <h3 class="text-xl font-bold text-white mb-2">Stuur een Bericht</h3>
          <p class="text-xs sm:text-sm text-gray-400 mb-6">Vul het onderstaande formulier in en ontvang binnen 15 minuten een reactie van onze supportmedewerkers.</p>

          <form id="contact-form" class="space-y-4">
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="contact-name" class="block text-xs font-bold text-gray-300 mb-1.5">Jouw Naam *</label>
                <input 
                  type="text" 
                  id="contact-name" 
                  name="name" 
                  required 
                  placeholder="bijv. Mark de Boer" 
                  class="w-full px-4 py-3 rounded-xl bg-white/5 border border-white/10 text-white placeholder-gray-500 text-sm focus:outline-none focus:ring-2 focus:ring-[#7c4ec2] focus:border-transparent transition-all"
                />
              </div>

              <div>
                <label for="contact-email" class="block text-xs font-bold text-gray-300 mb-1.5">E-mailadres *</label>
                <input 
                  type="email" 
                  id="contact-email" 
                  name="email" 
                  required 
                  placeholder="jouw.email@domein.nl" 
                  class="w-full px-4 py-3 rounded-xl bg-white/5 border border-white/10 text-white placeholder-gray-500 text-sm focus:outline-none focus:ring-2 focus:ring-[#7c4ec2] focus:border-transparent transition-all"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="contact-plan" class="block text-xs font-bold text-gray-300 mb-1.5">Gewenst Pakket</label>
                <select 
                  id="contact-plan" 
                  name="plan"
                  class="w-full px-4 py-3 rounded-xl bg-[#13131a] border border-white/10 text-white text-sm focus:outline-none focus:ring-2 focus:ring-[#7c4ec2] transition-all"
                >
                  <option value="12 Maanden + IBO Player (€35)">12 Maanden + IBO Player (€35) - Meest Populair</option>
                  <option value="6 Maanden (€20)">6 Maanden (€20)</option>
                  <option value="3 Maanden (€10)">3 Maanden (€10)</option>
                  <option value="1 Maand (€5)">1 Maand (€5)</option>
                  <option value="Vrijblijvende Vraag / Test">Vrijblijvende Vraag / Test</option>
                </select>
              </div>

              <div>
                <label for="contact-device" class="block text-xs font-bold text-gray-300 mb-1.5">Jouw Apparaat</label>
                <input 
                  type="text" 
                  id="contact-device" 
                  name="device" 
                  placeholder="bijv. Samsung Smart TV, Firestick" 
                  class="w-full px-4 py-3 rounded-xl bg-white/5 border border-white/10 text-white placeholder-gray-500 text-sm focus:outline-none focus:ring-2 focus:ring-[#7c4ec2] transition-all"
                />
              </div>
            </div>

            <div>
              <label for="contact-message" class="block text-xs font-bold text-gray-300 mb-1.5">Jouw Vraag of Opmerking *</label>
              <textarea 
                id="contact-message" 
                name="message" 
                rows="4" 
                required 
                placeholder="Typ hier je bericht of vraag over installatie of bestelling..." 
                class="w-full px-4 py-3 rounded-xl bg-white/5 border border-white/10 text-white placeholder-gray-500 text-sm focus:outline-none focus:ring-2 focus:ring-[#7c4ec2] transition-all"
              ></textarea>
            </div>

            <div class="pt-2 flex flex-col sm:flex-row gap-3">
              <button 
                type="submit" 
                class="flex-1 py-3.5 px-6 rounded-xl bg-gradient-to-r from-[#7c4ec2] to-[#e94560] hover:opacity-95 text-white font-extrabold text-sm shadow-xl shadow-[#7c4ec2]/30 transition-all flex items-center justify-center gap-2"
              >
                <span>Verstuur Bericht</span>
                <Send class="w-4 h-4" />
              </button>

              <button 
                type="button" 
                id="whatsapp-dispatch-btn"
                class="py-3.5 px-5 rounded-xl bg-emerald-600/30 hover:bg-emerald-600/50 border border-emerald-500/40 text-emerald-300 font-bold text-xs flex items-center justify-center gap-2 transition-all"
              >
                <MessageCircle class="w-4 h-4 text-emerald-400" />
                <span>Verstuur direct via WhatsApp</span>
              </button>
            </div>

            <p id="form-success-msg" class="hidden text-xs text-emerald-400 font-semibold text-center pt-2">
              ✓ Bedankt! Je bericht is succesvol verzonden. Wij nemen binnen 15 minuten contact met je op.
            </p>

          </form>

        </div>
      </div>

    </div>

  </div>
</section>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('contact-form');
    const successMsg = document.getElementById('form-success-msg');
    const waBtn = document.getElementById('whatsapp-dispatch-btn');

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      if (successMsg) {
        successMsg.classList.remove('hidden');
        form.reset();
      }
    });

    waBtn?.addEventListener('click', () => {
      const name = document.getElementById('contact-name')?.value || '';
      const plan = document.getElementById('contact-plan')?.value || '';
      const device = document.getElementById('contact-device')?.value || '';
      const msg = document.getElementById('contact-message')?.value || '';

      const text = `Hallo IPTV Nederlandse, mijn naam is ${name || 'Klant'}. Ik ben geïnteresseerd in: ${plan}. Apparaat: ${device || 'Niet gespecificeerd'}. Vraag: ${msg || 'Geen extra opmerkingen'}`;
      window.open(`https://wa.me/18036582620?text=${encodeURIComponent(text)}`, '_blank');
    });
  });
</script>
