---
import { ArrowRight, Sparkles, ShieldCheck, Zap, MessageCircle } from 'lucide-astro';
---

<section class="py-20 md:py-28 relative overflow-hidden bg-gradient-to-b from-[#0a0a0f] via-[#13131f] to-[#0a0a0f]">
  <!-- Decorative background elements -->
  <div class="absolute inset-0 bg-[radial-gradient(#7c4ec2_1px,transparent_1px)] [background-size:24px_24px] opacity-15"></div>
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[400px] bg-gradient-to-r from-[#7c4ec2]/20 via-[#e94560]/20 to-[#38bdf8]/15 blur-3xl pointer-events-none rounded-full"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="glass-card-glow rounded-3xl p-8 sm:p-12 lg:p-16 border border-[#7c4ec2]/40 relative overflow-hidden text-center shadow-2xl shadow-[#7c4ec2]/20">
      
      <!-- Top floating badge -->
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-[#e94560]/20 border border-[#e94560]/40 text-[#ff758f] text-xs font-extrabold uppercase tracking-wider mb-6">
        <Sparkles class="w-4 h-4 text-amber-400" />
        Altijd Inbegrepen: Gratis IBO Player Activatie bij 12 Maanden
      </div>

      <!-- Main Action Heading -->
      <h2 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-extrabold text-white tracking-tight max-w-4xl mx-auto leading-tight mb-6">
        Klaar Voor de Ultieme Kijkervaring? <br />
        <span class="text-gradient">Start Vandaag Jouw IPTV met Abonnement</span>
      </h2>

      <!-- Description text -->
      <p class="text-base sm:text-lg text-gray-300 max-w-2xl mx-auto mb-10 leading-relaxed">
        Sluit je aan bij meer dan 9.800 tevreden kijkers in Nederland. Binnen 5 minuten volledig geïnstalleerd op al je schermen, inclusief haarscherpe 4K kwaliteit, anti-freeze garantie en 24/7 Nederlandstalige WhatsApp ondersteuning.
      </p>

      <!-- Action Button Group -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 max-w-md mx-auto mb-10">
        <a 
          href="/#pricing" 
          class="w-full sm:w-auto px-8 py-4 rounded-xl bg-gradient-to-r from-[#7c4ec2] via-[#e94560] to-[#e94560] text-white font-extrabold text-base shadow-xl shadow-[#e94560]/30 hover:scale-105 active:scale-95 transition-all duration-200 flex items-center justify-center gap-2"
          aria-label="Bekijk prijzen en activeer direct"
        >
          <span>Bekijk Jaaractie (€35,-)</span>
          <ArrowRight class="w-5 h-5" />
        </a>

        <a 
          href="https://wa.me/18036582620?text=Hallo%20IPTV%20Nederlandse,%20ik%20wil%20graag%20direct%20een%20abonnement%20of%20test%20aanvragen." 
          target="_blank" 
          rel="noopener noreferrer"
          class="w-full sm:w-auto px-6 py-4 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-base shadow-lg shadow-emerald-900/40 hover:scale-105 active:scale-95 transition-all duration-200 flex items-center justify-center gap-2"
          aria-label="Direct bestellen via WhatsApp"
        >
          <MessageCircle class="w-5 h-5" />
          <span>Bestel via WhatsApp</span>
        </a>
      </div>

      <!-- Trust highlights beneath buttons -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 max-w-2xl mx-auto pt-6 border-t border-white/10 text-xs text-gray-300">
        <div class="flex items-center justify-center gap-2">
          <Zap class="w-4 h-4 text-[#38bdf8]" />
          <span>Instant Activatie (5 min.)</span>
        </div>
        <div class="flex items-center justify-center gap-2">
          <ShieldCheck class="w-4 h-4 text-emerald-400" />
          <span>100% Veilige Betaling</span>
        </div>
        <div class="flex items-center justify-center gap-2">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>Geen Automatische Verlenging</span>
        </div>
      </div>

    </div>
  </div>
</section>
