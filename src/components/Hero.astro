---
import { ShieldCheck, Zap, Star, ArrowRight, CheckCircle2, Play, Sparkles } from 'lucide-astro';

interface Props {
  city?: string;
}

const { city } = Astro.props;

const heroTitle = city 
  ? `IPTV met Abonnement in ${city} — 4K Streaming Zonder Haperingen`
  : "IPTV met Abonnement Kopen — Direct Activeren & 4K Streaming Zonder Haperingen";
---

<section class="relative pt-32 pb-20 md:pt-40 md:pb-28 overflow-hidden">
  <!-- Subtle ambient background gradients -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-gradient-to-br from-[#7c4ec2]/20 via-[#e94560]/15 to-transparent rounded-full blur-3xl pointer-events-none -z-10"></div>
  <div class="absolute top-20 right-10 w-72 h-72 bg-[#38bdf8]/10 rounded-full blur-2xl pointer-events-none -z-10"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Left Column: Copy & High-Converting Value Proposition -->
      <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
        
        <!-- Live Alert Badge -->
        <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full bg-white/5 border border-white/10 backdrop-blur-md shadow-inner text-xs font-semibold text-gray-200">
          <span class="flex h-2.5 w-2.5 relative">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#e94560] opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-[#e94560]"></span>
          </span>
          <span>Altijd Inbegrepen: <strong class="text-white">12 Maanden + Gratis IBO Player Bonus</strong></span>
        </div>

        <!-- Main H1 Heading (Strictly Single H1 per page) -->
        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-tight text-white leading-[1.15]">
          {heroTitle.split('—')[0]} 
          <span class="block text-gradient mt-2">
            {heroTitle.split('—')[1] || "Direct Activeren & 4K Zonder Haperingen"}
          </span>
        </h1>

        <!-- SEO-Optimized Opening Paragraph (Targeting Core Keyword within first 80 words) -->
        <p class="text-base sm:text-lg text-gray-300 leading-relaxed max-w-2xl mx-auto lg:mx-0">
          Zoek je een betrouwbaar <strong>IPTV met abonnement</strong> in Nederland? Bij <strong>IPTV Nederlandse</strong> geniet je van ultra-stabiele 4K en Full HD streams zonder haperingen of bufferen. Of je nu een compleet <em>ip tv abonnement</em> wilt afsluiten, voordelig een <em>iptv abbo kopen</em> voor al je apparaten, of direct live Eredivisie en internationale sport wilt volgen: jouw account is binnen 5 minuten actief.
        </p>

        <!-- Bullet Highlights -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2 text-left max-w-lg mx-auto lg:mx-0">
          <div class="flex items-center gap-2.5 text-sm text-gray-200">
            <CheckCircle2 class="w-4 h-4 text-emerald-400 shrink-0" />
            <span>Anti-Freeze Technologie 99.9% Uptime</span>
          </div>
          <div class="flex items-center gap-2.5 text-sm text-gray-200">
            <CheckCircle2 class="w-4 h-4 text-emerald-400 shrink-0" />
            <span>Geschikt voor Smart TV, Firestick & Mobiel</span>
          </div>
          <div class="flex items-center gap-2.5 text-sm text-gray-200">
            <CheckCircle2 class="w-4 h-4 text-emerald-400 shrink-0" />
            <span>Directe M3U & Xtream Codes Levering</span>
          </div>
          <div class="flex items-center gap-2.5 text-sm text-gray-200">
            <CheckCircle2 class="w-4 h-4 text-emerald-400 shrink-0" />
            <span>Geschikt voor Smart TV, Firestick, iOS & Android</span>
          </div>
        </div>

        <!-- Primary Action CTAs -->
        <div class="pt-4 flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
          <a 
            href="/#pricing" 
            class="w-full sm:w-auto px-8 py-4 rounded-full bg-gradient-to-r from-[#7c4ec2] to-[#e94560] text-white font-extrabold text-sm sm:text-base shadow-xl shadow-[#7c4ec2]/30 hover:scale-105 active:scale-95 transition-all duration-200 flex items-center justify-center gap-2 group"
            aria-label="Direct IPTV Abonnement Kopen"
          >
            <span>Bekijk Jaaractie (€35 / Jaar)</span>
            <ArrowRight class="w-5 h-5" />
          </a>

          <a 
            href="https://wa.me/18036582620?text=Hallo%20IPTV%20Nederlandse,%20ik%20wil%20graag%20een%20vrijblijvende%20test%20of%20informatie%20ontvangen." 
            target="_blank" 
            rel="noopener noreferrer"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-4 rounded-xl bg-white/5 hover:bg-white/10 text-white font-semibold text-base border border-white/15 transition-all duration-200"
            aria-label="Vraag gratis proefperiode of advies via WhatsApp"
          >
            <Play class="w-4 h-4 text-[#38bdf8] fill-current" />
            <span>Gratis Test via WhatsApp</span>
          </a>
        </div>

        <!-- Social Proof Trust Bar -->
        <div class="pt-4 flex items-center justify-center lg:justify-start gap-6 text-xs text-gray-400">
          <div class="flex items-center gap-1.5">
            <div class="flex text-amber-400">
              <Star class="w-4 h-4 fill-current" />
              <Star class="w-4 h-4 fill-current" />
              <Star class="w-4 h-4 fill-current" />
              <Star class="w-4 h-4 fill-current" />
              <Star class="w-4 h-4 fill-current" />
            </div>
            <span class="font-bold text-white">4.9/5</span>
            <span>(9.850+ reviews)</span>
          </div>
          <div class="hidden sm:flex items-center gap-2 border-l border-white/10 pl-6">
            <ShieldCheck class="w-4 h-4 text-emerald-400" />
            <span>100% Veilige SSL Betaling</span>
          </div>
        </div>

      </div>

      <!-- Right Column: Premium Glassmorphic Streaming Visualizer -->
      <div class="lg:col-span-5 relative">
        <div class="relative mx-auto max-w-md lg:max-w-none">
          
          <!-- Outer decorative glowing border -->
          <div class="absolute -inset-1 bg-gradient-to-r from-[#7c4ec2] via-[#e94560] to-[#38bdf8] rounded-3xl blur-md opacity-30 group-hover:opacity-100 transition duration-1000"></div>
          
          <!-- Main Showcase Glass Card -->
          <div class="relative glass-card-glow rounded-2xl p-6 shadow-2xl border border-white/10 space-y-5">
            
            <!-- Card Header -->
            <div class="flex items-center justify-between border-b border-white/10 pb-4">
              <div class="flex items-center gap-3">
                <div class="w-3 h-3 rounded-full bg-emerald-400 animate-ping"></div>
                <div>
                  <span class="text-xs font-bold text-white uppercase tracking-wider block">Live Stream Hub</span>
                  <span class="text-[11px] text-gray-400">Ultra Low-Latency Verbinding</span>
                </div>
              </div>
              <span class="px-2.5 py-1 rounded-md bg-[#e94560]/20 border border-[#e94560]/40 text-[#ff758f] text-[11px] font-bold">
                4K 60FPS
              </span>
            </div>

            <!-- Simulated Stream Display -->
            <div class="relative h-48 sm:h-56 rounded-xl bg-gradient-to-br from-[#1a1a2e] to-[#0f0f1a] border border-white/10 flex flex-col justify-between p-4 overflow-hidden group">
              <div class="absolute inset-0 bg-[radial-gradient(#7c4ec2_1px,transparent_1px)] [background-size:16px_16px] opacity-20"></div>
              
              <div class="flex justify-between items-start z-10">
                <span class="px-2.5 py-1 rounded-full bg-black/60 backdrop-blur-md text-[11px] font-semibold text-white flex items-center gap-1.5">
                  <span class="w-1.5 h-1.5 rounded-full bg-red-500"></span> Eredivisie & Sport
                </span>
                <span class="text-xs font-mono text-[#38bdf8] bg-black/50 px-2 py-0.5 rounded">
                  99.98% UPTIME
                </span>
              </div>

              <!-- Center Play/Performance Pulse -->
              <div class="my-auto flex flex-col items-center justify-center z-10 text-center">
                <div class="w-12 h-12 rounded-full bg-gradient-to-tr from-[#7c4ec2] to-[#e94560] flex items-center justify-center shadow-lg shadow-[#e94560]/40 mb-2">
                  <Zap class="w-6 h-6 text-white" />
                </div>
                <span class="text-sm font-bold text-white">Vloeiende Streaming Zonder Buffering</span>
                <span class="text-xs text-gray-400">Geoptimaliseerd voor alle Nederlandse internetproviders</span>
              </div>

              <div class="flex items-center justify-between text-[11px] text-gray-400 z-10 pt-2 border-t border-white/5">
                <span>Anti-Freeze v4.2</span>
                <span class="text-emerald-400 font-semibold">Status: Actief & Stabiel</span>
              </div>
            </div>

            <!-- Quick Specs Badges -->
            <div class="grid grid-cols-3 gap-2.5 pt-1 text-center">
              <div class="p-2.5 rounded-xl bg-white/5 border border-white/5">
                <span class="block text-xs font-bold text-white">5 Min.</span>
                <span class="text-[10px] text-gray-400">Activatie</span>
              </div>
              <div class="p-2.5 rounded-xl bg-white/5 border border-white/5">
                <span class="block text-xs font-bold text-[#38bdf8]">24/7 Hulp</span>
                <span class="text-[10px] text-gray-400">WhatsApp Chat</span>
              </div>
              <div class="p-2.5 rounded-xl bg-white/5 border border-white/5">
                <span class="block text-xs font-bold text-emerald-400">60 FPS</span>
                <span class="text-[10px] text-gray-400">Sport Streams</span>
              </div>
            </div>

            <!-- Featured Deal Callout Box -->
            <div class="p-3.5 rounded-xl bg-gradient-to-r from-[#7c4ec2]/20 to-[#e94560]/20 border border-[#7c4ec2]/30 flex items-center justify-between">
              <div>
                <span class="text-xs font-bold text-white flex items-center gap-1.5">
                  <Sparkles class="w-3.5 h-3.5 text-amber-400" />
                  12 Maanden + IBO Player
                </span>
                <span class="text-[11px] text-gray-300">Beste prijs-kwaliteitverhouding</span>
              </div>
              <div class="text-right">
                <span class="text-base font-extrabold text-[#e94560]">€35,-</span>
                <span class="text-[10px] text-gray-400 block">per jaar</span>
              </div>
            </div>

          </div>
        </div>
      </div>

    </div>
  </div>
</section>
